# Optional: local-only budgeting works without any environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Only for testing a production build on local HTTP. Leave unset on HTTPS hosts.
POCKET_LOCAL_HTTP=false

# Your exact app origin, used by optional email sign-in links.
APP_URL=http://127.0.0.1:3000
